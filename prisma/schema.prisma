// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PasswordAlgo {
  bcrypt
  argon2
}

enum Role {
  student
  company
  admin
}

enum CompanyMemberRole {
  owner
  hr
  reviewer
}

enum MemberStatus {
  active
  invited
  disabled
}

enum JobType {
  intern
  part_time
  full_time
}

enum WorkMode {
  onsite
  hybrid
  remote
}

enum JobStatus {
  draft
  open
  closed
}

enum ApplicationStatus {
  submitted
  reviewing
  interview
  offer
  rejected
  withdrawn
}

model UserCredential {
  userId       String       @id @db.Uuid
  email        String       @unique
  passwordHash String
  passwordAlgo PasswordAlgo @default(bcrypt)
  isActive     Boolean      @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  profile Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([email])
  @@map("user_credentials")
}

model Profile {
  userId      String   @id @db.Uuid
  role        Role
  displayName String
  avatarUrl   String?
  phone       String?
  university  String?
  faculty     String?
  major       String?
  yearLevel   Int?
  bio         String?
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  credential   UserCredential? // ✅ One-to-One relation
  companies    CompanyMember[]
  portfolio    Portfolio?
  applications Application[]

  @@map("profiles")
}

model Company {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  logoUrl   String?
  website   String?
  about     String?
  industry  String?
  sizeRange String?
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members CompanyMember[]
  jobs    Job[]

  @@map("companies")
}

model CompanyMember {
  companyId  String            @db.Uuid
  userId     String            @db.Uuid
  memberRole CompanyMemberRole
  status     MemberStatus      @default(active)
  createdAt  DateTime          @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@id([companyId, userId])
  @@map("company_members")
}

model Job {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @db.Uuid
  title        String
  description  String
  requirements String?
  jobType      JobType
  workMode     WorkMode
  location     String?
  stipendMin   Int?
  stipendMax   Int?
  currency     String    @default("THB")
  tags         String[]  @default([])
  openings     Int       @default(1)
  startDate    DateTime?
  endDate      DateTime?
  status       JobStatus @default(draft)
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications Application[]

  @@index([companyId, status, publishedAt(sort: Desc)])
  @@index([status, publishedAt(sort: Desc)])
  @@map("jobs")
}

model Portfolio {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @db.Uuid
  slug       String   @unique
  headline   String?
  summary    String?
  theme      String   @default("default")
  isPublic   Boolean  @default(true)
  viewsCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user         Profile       @relation(fields: [userId], references: [userId], onDelete: Cascade)
  applications Application[]

  @@map("portfolios")
}

model Application {
  id            String            @id @default(uuid()) @db.Uuid
  jobId         String            @db.Uuid
  studentUserId String            @db.Uuid
  portfolioId   String?           @db.Uuid
  resumeUrl     String?
  coverLetter   String?
  status        ApplicationStatus @default(submitted)
  appliedAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  job       Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  student   Profile    @relation(fields: [studentUserId], references: [userId], onDelete: Cascade)
  portfolio Portfolio? @relation(fields: [portfolioId], references: [id], onDelete: SetNull)

  @@unique([jobId, studentUserId])
  @@index([jobId, status, appliedAt(sort: Desc)])
  @@index([studentUserId, appliedAt(sort: Desc)])
  @@map("applications")
}
